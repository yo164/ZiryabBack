generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model Student {
  id          Int      @id @default(autoincrement())
  email       String   @unique
  name        String
  surname     String
  ndSurname   String?
  birthDate   DateTime
  dni         String?  @unique
  role        String   @default("STUDENT")
  firebaseUID String   @unique
  //isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  
  enrollments      StudentOnSubjectOnGroup[]
  issuesAsTarget   Issue[]                   @relation("IssueTargetStudent")
}

model Teacher {
  id          Int      @id @default(autoincrement())
  email       String   @unique
  name        String
  surname     String
  ndSurname   String?
  birthDate   DateTime
  dni         String   @unique
  role        String   @default("TEACHER")
  firebaseUID String   @unique
  //isActive   Boolean  @default(true)  // NUEVO: También para profesores (bajas, jubilaciones)
  createdAt  DateTime @default(now())
  
  assignments       TeacherOnSubjectOnGroup[]
  tutorCourseGroups CourseGroup[]
  grades            Grade[]
  issuesAsTarget   Issue[]                   @relation("IssueTargetTeacher")
}

model Admin {
  id          Int      @id @default(autoincrement())
  email       String   @unique
  name        String
  surname     String
  ndSurname   String?
  birthDate   DateTime
  dni         String   @unique
  role        String   @default("ADMIN")
  firebaseUID String   @unique
  createdAt  DateTime @default(now())

  issues     Issue[]
}

model Course {
  id          Int      @id @default(autoincrement())
  name        String   @unique 
  description String? 
  duration    Int      @default(2) 
  //isActive    Boolean  @default(true)  
  createdAt   DateTime @default(now())

  subjects     Subject[]
  courseGroups CourseGroup[]
  issues       Issue[]
}

// Combinación Ciclo + Grupo + Grado (la "clase" real, ej: 1º DAM Mañana)
model CourseGroup {
  id        Int      @id @default(autoincrement())

  idCourse  Int
  course    Course   @relation(fields: [idCourse], references: [id], onDelete: Cascade)

  idGroup   Int
  group     Group    @relation(fields: [idGroup], references: [id], onDelete: Cascade)

  grade     String   // "1" o "2" — curso dentro del ciclo

  tutorId   Int?
  tutor     Teacher? @relation(fields: [tutorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  // Una clase = ciclo + grupo + grado únicos
  @@unique([idCourse, idGroup, grade])
}

model Subject {
  id          Int     @id @default(autoincrement())
  name        String
  //code        String?  
  grade       String 
  hours       Int? 
  description String?

  idCourse Int
  course   Course @relation(fields: [idCourse], references: [id], onDelete: Cascade)

  studentEnrollments StudentOnSubjectOnGroup[]
  teacherAssignments TeacherOnSubjectOnGroup[]
  issues             Issue[]

  // NUEVO: Evita duplicar asignaturas en el mismo ciclo y curso
  @@unique([name, idCourse, grade])
  @@index([idCourse, grade]) 
}

model Group {
  id          Int      @id @default(autoincrement())
  name        String
  //shift       String?  // NUEVO: "Mañana", "Tarde", "Noche" (más estructurado)
  capacity    Int?     // NUEVO: Capacidad máxima de alumnos
  
  createdAt   DateTime @default(now())
  
  studentEnrollments StudentOnSubjectOnGroup[]
  teacherAssignments TeacherOnSubjectOnGroup[]
  courseGroups       CourseGroup[]
  issues             Issue[]
}

enum AssignmentStatus {
  ACTIVE // EQUIVALENTE DE ENROLLED PARA STUDENT
  SUSPENDED //SUSPENDIDO DE EMPLEO Y SUELDO(NO SE SI SE LO HACENA LOS FUNCIONARIOS PERO)
  ILLNESS //BAJA POR ENFERMEDAD
  EXCEDENCE //ESTA DE EXCEDENCIA
  WITHDRAWN // BAJA VOLUNTARIA EN PUESTO DE TRABAJO
  STANDBY //PROFESOR QUE ESTA EN EL SISTEMA PERO NO DA CLASE EN NINGUN CENTRO
}

model TeacherOnSubjectOnGroup {
  id Int @id @default(autoincrement())

  idTeacher Int
  teacher   Teacher @relation(fields: [idTeacher], references: [id], onDelete: Cascade)

  idSubject Int
  subject   Subject @relation(fields: [idSubject], references: [id], onDelete: Cascade)

  idGroup Int
  group   Group @relation(fields: [idGroup], references: [id], onDelete: Cascade)

  schoolYear String // Formato: "2024-2025"
  status     AssignmentStatus @default(STANDBY)
  //isActive   Boolean  @default(true)  // NUEVO: Si la asignación está vigente
  createdAt  DateTime         @default(now())

  WeekSchedule WeekSchedule[] @relation(name: "TeacherAssignment")
  tasks        Task[]

  @@unique([idTeacher, idSubject, idGroup, schoolYear])
  @@index([schoolYear]) // consultas por año académico
  @@index([idTeacher, schoolYear]) //Para ver carga de un profesor
}

enum EnrollmentStatus {
  ENROLLED //MATRICULADO
  EVALUATION_LOST //EVALUACION PERDIDA
  COMPLETED // PASADO
  FAILED //SUSPENSO
  WITHDRAWN // BAJA VOLUNTARIA
  EXPELLED // EXPULSADO
}

model StudentOnSubjectOnGroup {
  id Int @id @default(autoincrement())

  idStudent Int
  student   Student @relation(fields: [idStudent], references: [id], onDelete: Cascade)

  idGroup Int
  group   Group @relation(fields: [idGroup], references: [id], onDelete: Cascade)

  idSubject Int
  subject   Subject @relation(fields: [idSubject], references: [id], onDelete: Cascade)

  schoolYear String // Formato: "2024-2025"
  status     EnrollmentStatus @default(ENROLLED) //"ENROLLED", "COMPLETED", "FAILED", "WITHDRAWN"

  createdAt DateTime @default(now())

  // FUTURO: Aquí podrás añadir calificaciones
  // finalGrade Decimal?
  // examGrades Json?

  Assistance   Assistance[]  @relation(name: "StudentEnrollment")
  studentTasks StudentTask[]
  grades       Grade[]

  @@unique([idStudent, idGroup, idSubject, schoolYear])
  @@index([schoolYear, status])
  @@index([idStudent, schoolYear])
}

enum EvaluationPeriod {
  INITIAL
  FIRST_TRIMESTER
  SECOND_TRIMESTER
  THIRD_TRIMESTER
  FINAL
}

model Grade {
  id                  Int                     @id @default(autoincrement())
  idStudentEnrollment Int
  studentEnrollment   StudentOnSubjectOnGroup @relation(fields: [idStudentEnrollment], references: [id], onDelete: Cascade)
  period              EvaluationPeriod
  value               Int?
  observations        String?
  idTeacher           Int
  teacher             Teacher                 @relation(fields: [idTeacher], references: [id], onDelete: Restrict)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@unique([idStudentEnrollment, period])
  @@index([idTeacher])
}

// Días de la semana para el horario
enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

//horariosemana
model WeekSchedule {
  id                  Int                     @id @default(autoincrement())
  idTeacherAssignment Int
  teacherAssignment   TeacherOnSubjectOnGroup @relation(fields: [idTeacherAssignment], references: [id], name: "TeacherAssignment", onDelete: Cascade)
  label               String                  @default("")
  weekDay             DayOfWeek
  startTime           String
  finishTime          String

  createdAt DateTime @default(now())

  sessions SessionClass[]

  @@index([idTeacherAssignment, weekDay])
  @@index([label])
}

// Estados de una sesión de clase
enum SessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

//una clase propiamente hablando
model SessionClass {
  id         Int          @id @default(autoincrement())
  idSchedule Int
  schedule   WeekSchedule @relation(fields: [idSchedule], references: [id], onDelete: Cascade) //horario

  date        DateTime //fecha
  status      SessionStatus @default(SCHEDULED) // PROGRAMADA, REALIZADA, CANCELADA estado
  apointments String? //detalles, observaciones

  createdAt DateTime @default(now())

  assistances Assistance[]

  @@unique([idSchedule, date])
  @@index([date])
}

// Estados de asistencia
enum AssistanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum JustificationStatus {
  PENDING // Enviado por el alumno, pendiente de revisión
  VIEWED // El profesor lo ha visto
  REJECTED // Rechazado, no válido
  // Aceptado = AssistanceStatus cambia a JUSTIFY
}

//asistencia
model Assistance {
  id        Int          @id @default(autoincrement())
  idSession Int
  session   SessionClass @relation(fields: [idSession], references: [id], onDelete: Cascade)

  idStudentEnrollment Int
  studentEnrollment   StudentOnSubjectOnGroup @relation(fields: [idStudentEnrollment], references: [id], name: "StudentEnrollment", onDelete: Cascade)

  status              AssistanceStatus     @default(PRESENT) // PRESENTE, AUSENTE, RETRASO, JUSTIFICADA
  justificationUri    String? // URL/path del archivo subido
  justificationStatus JustificationStatus? // null = sin justificante enviado o estaba presente

  createdAt DateTime @default(now())

  @@unique([idSession, idStudentEnrollment]) // Un alumno solo puede tener una asistencia por sesión
  @@index([idStudentEnrollment]) //filtra por id StudentOnSubjectOnGroup
  @@index([idSession, status]) //filtra por estado y clase
}

model TaskGroup {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  tasks     Task[]
}

enum TaskType {
  PRACTICE // Práctica
  THEORY // Teoría/trabajo/material
  EXAM // Examen
  PROJECT // Proyecto
  HOMEWORK // Deberes
}

model Task {
  id Int @id @default(autoincrement())

  idTeacherAssignment Int
  teacherAssignment   TeacherOnSubjectOnGroup @relation(fields: [idTeacherAssignment], references: [id], onDelete: Cascade)

  idTaskGroup Int?
  taskGroup   TaskGroup? @relation(fields: [idTaskGroup], references: [id], onDelete: SetNull)

  title       String
  description String?
  type        TaskType

  startDate DateTime // Fecha/hora desde que se puede ver
  dueDate   DateTime // Fecha/hora límite de entrega

  isPublished         Boolean @default(false)
  allowLateSubmission Boolean @default(false)

  attachmentUrl String? //url del fichero que sube el profesor, puede ser temario o contenido para una tarea

  schoolYear String // "2024-2025"

  createdAt DateTime @default(now())

  studentTasks StudentTask[] // Entregas de los alumnos

  @@index([idTeacherAssignment, schoolYear])
  @@index([dueDate])
}

enum SubmissionStatus {
  PENDING // Pendiente de entregar
  SUBMITTED // Entregada
  LATE // Entregada tarde
  GRADED // Calificada
  NOT_SUBMITTED // No entregada (después de la fecha)
}

model StudentTask {
  id Int @id @default(autoincrement())

  idTask Int
  task   Task @relation(fields: [idTask], references: [id], onDelete: Cascade)

  idStudentEnrollment Int
  studentEnrollment   StudentOnSubjectOnGroup @relation(fields: [idStudentEnrollment], references: [id], onDelete: Cascade)

  isEnabled      Boolean          @default(true)
  status         SubmissionStatus @default(PENDING)
  submissionDate DateTime? // Fecha/hora de entrega (null si no ha entregado)
  score          Decimal? // Nota (null si no está calificada)
  feedback       String? // Comentarios del profesor
  attachmentUrl  String? // URL del archivo subido (opcional)

  createdAt DateTime @default(now())

  @@unique([idTask, idStudentEnrollment]) // Un alumno solo puede tener una entrega por tarea
  @@index([idStudentEnrollment, status])
  @@index([idTask, status])
}

model Notification {
  id                   Int       @id @default(autoincrement())
  recipientFirebaseUID String
  title                String
  message              String
  type                 String    @default("INFO")
  isRead               Boolean   @default(false)
  readAt               DateTime?
  createdAt            DateTime  @default(now())

  @@index([recipientFirebaseUID, isRead, createdAt])
}

model Announcement {
  id              Int      @id @default(autoincrement())
  title           String
  body            String
  createdAt       DateTime @default(now())
  createdByUserId Int
}
enum IssueAudience {
  CENTER
  ALL_TEACHERS
  ALL_STUDENTS
  GROUP
  COURSE
  SUBJECT_GROUP
  TEACHER
  STUDENT
}

model Issue {
  id            Int              @id @default(autoincrement())

  idAdmin       Int
  admin         Admin            @relation(fields: [idAdmin], references: [id], onDelete: Restrict)

  audience      IssueAudience
  idGroup       Int?
  group         Group?           @relation(fields: [idGroup], references: [id], onDelete: SetNull)
  idCourse      Int?
  course        Course?          @relation(fields: [idCourse], references: [id], onDelete: SetNull)
  idSubject     Int?
  subject       Subject?         @relation(fields: [idSubject], references: [id], onDelete: SetNull)
  grade         String?          // "1" | "2" = curso (1º/2º). Solo audiencia COURSE. idCourse = ciclo (DAM, DAW…)
  idTargetTeacher Int?
  targetTeacher   Teacher?       @relation("IssueTargetTeacher", fields: [idTargetTeacher], references: [id], onDelete: SetNull)
  idTargetStudent Int?
  targetStudent   Student?       @relation("IssueTargetStudent", fields: [idTargetStudent], references: [id], onDelete: SetNull)

  title         String
  body          String
  attachmentUrl String?

  isPublished   Boolean          @default(false)
  publishAt     DateTime?
  expiresAt     DateTime?

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([audience, idGroup])
  @@index([audience, idCourse, grade])
  @@index([audience, idTargetTeacher])
  @@index([audience, idTargetStudent])
  @@index([createdAt])
  @@index([expiresAt])
  @@index([isPublished, publishAt])
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model Student {
  id         Int      @id @default(autoincrement())
  email      String   @unique
  name       String
  surname    String
  ndSurname  String?
  birthDate  DateTime
  dni        String   @unique
  role       String   @default("STUDENT")
  createdAt  DateTime @default(now())

  subject    StudentOnSubjectonGroup[]
}

model Teacher {
  id         Int      @id @default(autoincrement())
  email      String   @unique
  name       String
  surname    String
  ndSurname  String?
  birthDate  DateTime
  dni        String   @unique
  role       String   @default("TEACHER")
  createdAt  DateTime @default(now())

  subject    TeacherOnSubject[]
}

model Admin {
  id         Int      @id @default(autoincrement())
  email      String   @unique
  name       String
  surname    String
  ndSurname  String?
  birthDate  DateTime
  dni        String   @unique
  role       String   @default("ADMIN")
  createdAt  DateTime @default(now())
}

model Course {
  id       Int      @id @default(autoincrement())
  name     String

  subjects Subject[]
}

model Subject {
  id       Int      @id @default(autoincrement())
  name     String   @unique
  idCourse Int
  course   Course   @relation(fields: [idCourse], references: [id])

  student  StudentOnSubjectonGroup[]
  teacher  TeacherOnSubject[]
}

model Group {
  id        Int      @id @default(autoincrement())
  name      String

  createdAt DateTime @default(now())

  student   StudentOnSubjectonGroup[]

  
}

model TeacherOnSubject {
  idSubject Int
  subject   Subject @relation(fields: [idSubject], references: [id])

  idTeacher Int
  teacher   Teacher @relation(fields: [idTeacher], references: [id])

  @@id([idSubject, idTeacher])
}

model StudentOnSubjectonGroup {
  id       Int      @id @default(autoincrement())

  idStudent  Int
  student    Student @relation(fields: [idStudent], references: [id])

  idGroup    Int
  group      Group   @relation(fields: [idGroup], references: [id])

  idSubject  Int
  subject    Subject @relation(fields: [idSubject], references: [id])

  schoolYear String
  createdAt  DateTime @default(now())

  @@unique([idStudent, idGroup, idSubject, schoolYear])
 
}